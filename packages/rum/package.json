{
  "name": "@mubox/local-rum",
  "version": "1.0.0",
  "description": "The RUM collection endpoint providing user analytics for MUBox.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "check-format": "prettier . --check",
    "clean": "rm -rf coverage node_modules",
    "fix": "prettier . --write && eslint . --fix",
    "lint": "eslint .",
    "test": "vitest run",
    "type-check": "tsc"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/build/rum-lambda"
        ]
      }
    }
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.25.2",
    "@aws-lambda-powertools/metrics": "^2.25.2",
    "@aws-lambda-powertools/parser": "^2.25.2",
    "@aws-lambda-powertools/tracer": "^2.25.2",
    "@aws-sdk/client-cloudwatch-logs": "^3.879.0",
    "@aws-sdk/client-rum": "^3.879.0",
    "@middy/core": "^6.4.4",
    "zod": "^4.1.5"
  }
}
