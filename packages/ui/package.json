{
  "name": "@mubox/local-ui",
  "version": "1.0.0",
  "description": "The UI for MUBox",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "check-format": "prettier . --check",
    "clean": "rm -rf build coverage node_modules",
    "fix": "prettier . --write && eslint . --fix",
    "lint": "eslint .",
    "start": "vite dev",
    "test": "vitest run",
    "type-check": "tsc"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{workspaceRoot}/build/ui"
        ]
      },
      "fix": {
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "dependsOn": [
          "^build"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      },
      "type-check": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@mubox/local-shared": "1.0.0",
    "@mubox/local-tsflap": "1.0.0",
    "@cloudscape-design/chat-components": "^1.0.58",
    "@cloudscape-design/code-view": "^3.0.68",
    "@cloudscape-design/components": "^3.0.1051",
    "@cloudscape-design/design-tokens": "^3.0.59",
    "@cloudscape-design/global-styles": "^1.0.45",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.84.1",
    "@trpc/client": "^11.5.0",
    "@trpc/tanstack-react-query": "^11.5.0",
    "aws-rum-web": "^1.25.0",
    "markdown-to-jsx": "^7.7.13",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-router": "^7.8.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@mubox/local-api": "1.0.0",
    "@aws-sdk/types": "^3.862.0",
    "@smithy/protocol-http": "^5.1.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
