{
  "name": "@mubox/local-interceptor",
  "version": "1.0.0",
  "description": "The Lambda@Edge function responsible for human authentication to the CloudFront distribution fronting the MUBox website.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "check-format": "prettier . --check",
    "clean": "rm -rf coverage node_modules",
    "fix": "prettier . --write && eslint . --fix",
    "lint": "eslint .",
    "test": "vitest run",
    "type-check": "tsc"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/build/interceptor-edge-lambda"
        ]
      }
    }
  },
  "dependencies": {
    "cognito-at-edge": "1.5.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149"
  }
}
