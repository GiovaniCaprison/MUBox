{
  "name": "@mubox/local-root",
  "version": "1.0.0",
  "description": "The root package for the MUBox monorepo.",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "files": [],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run tasks build",
    "cdk": "npm run tasks cdk -- --",
    "check-format": "npm run tasks check-format",
    "clean": "npm run tasks clean && rm -rf .nx build/ build node_modules",
    "clean:cache": "nx reset",
    "fix": "npm run tasks fix",
    "lint": "npm run tasks lint",
    "release": "npm run tasks build,check-format,lint,test,type-check",
    "start": "npm run tasks start",
    "tasks": "nx run-many --nxBail=true --output-style=stream --parallel=8 -t",
    "tasks:graph": "nx graph",
    "test": "npm run tasks test",
    "test:ui": "vitest --ui",
    "test:update-snapshot": "npm run tasks test:update-snapshot",
    "test:watch": "vitest",
    "type-check": "npm run tasks type-check"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@swc-node/register": "^1.10.10",
    "@swc/core": "^1.11.31",
    "@types/node": "^22.15.11",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "esbuild": "^0.25.3",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "nx": "^21.1.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "react": "^19.1.1",
    "rolldown": "1.0.0-beta.40",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "npm:rolldown-vite@7.1.13",
    "vitest": "^3.2.4"
  }
}
